PORT=5001
NODE_ENV=development
# Browser origins allowed to call the API: comma-separated, exact (https://host[:port]).
# Empty = the production frontend plus Vite on localhost/127.0.0.1 ports 5173 and 4173.
CORS_ORIGINS=
# Bearer key for the operator-only saved-routes endpoints (/api/routes). Empty = switched off (404).
# Never put it in frontend code or a VITE_ variable.
ADMIN_API_KEY=
